# Copy to api/.env for local development. NEVER commit real values: api/.env is git-ignored.
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Local: sqlite:///db.sqlite3   Production: a PostgreSQL URL (for example from Neon via the Vercel Marketplace)
DATABASE_URL=sqlite:///db.sqlite3
# Address of the storefront. Paystack sends customers back to SITE_URL/order/confirmation.
SITE_URL=http://localhost:3000

# Paystack. Use sk_test_... while testing and sk_live_... only on the live server.
# The secret key belongs on the server only. It is never sent to the browser.
PAYSTACK_SECRET_KEY=
# Optional extra protection for the webhook: comma-separated Paystack source IPs.
PAYSTACK_WEBHOOK_IPS=

# Order emails. Staff addresses receive each paid order; the customer gets a receipt.
ORDER_NOTIFY_EMAILS=sales@alanyogroup.com
# Website contact-form enquiries go here (defaults to sales@alanyogroup.com).
ENQUIRY_EMAILS=sales@alanyogroup.com
DEFAULT_FROM_EMAIL=Alanyo Group <sales@alanyogroup.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Optional: move the staff admin off /admin/ (no leading slash, keep the trailing slash).
ADMIN_URL=admin/
# Optional: shared Redis for rate limiting across instances.
REDIS_URL=
